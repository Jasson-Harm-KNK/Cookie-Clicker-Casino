{
	// game/ (Steam) and game-web/ (browser) contain the game's own code and are reference only
	"files.readonlyInclude": {
		"game/**": true,
		"game-web/**": true
	},
	// the development Chrome profile is large and changes constantly
	"files.exclude": {
		".dev/chrome-profile": true
	},
	"files.watcherExclude": {
		"**/.dev/chrome-profile/**": true
	},
	"search.exclude": {
		".dev": true
	},
	"files.associations": {
		"**/mod/info.txt": "json"
	},
	// same indentation as the game's own code
	"[javascript]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 4
	},
	"[python]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 4
	}
}
